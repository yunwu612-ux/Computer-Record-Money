<Window x:Class="LocalBookkeeper.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="我的账本 V1.1" Width="1100" Height="720"
    MinWidth="900" MinHeight="600"
    WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="我的账本" FontSize="30" FontWeight="Bold"/>
                <TextBlock Text="V1.1 · 简单、清晰、数据本地保存" Foreground="Gray"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="账户管理" Padding="18,8" Click="Accounts_Click"/>
        </DockPanel>

        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,14">
            <Border Margin="4" Padding="14" Background="#EEF5FF" CornerRadius="8">
                <StackPanel><TextBlock Text="当前资产"/><TextBlock x:Name="AssetText" FontSize="22" FontWeight="Bold"/></StackPanel>
            </Border>
            <Border Margin="4" Padding="14" Background="#EEF9F0" CornerRadius="8">
                <StackPanel><TextBlock Text="本月收入"/><TextBlock x:Name="IncomeText" FontSize="22" FontWeight="Bold"/></StackPanel>
            </Border>
            <Border Margin="4" Padding="14" Background="#FFF3F0" CornerRadius="8">
                <StackPanel><TextBlock Text="本月支出"/><TextBlock x:Name="ExpenseText" FontSize="22" FontWeight="Bold"/></StackPanel>
            </Border>
            <Border Margin="4" Padding="14" Background="#FFF8E8" CornerRadius="8">
                <StackPanel><TextBlock Text="应付款"/><TextBlock x:Name="PayableText" FontSize="22" FontWeight="Bold"/></StackPanel>
            </Border>
            <Border Margin="4" Padding="14" Background="#F2EEFF" CornerRadius="8">
                <StackPanel><TextBlock Text="待收款"/><TextBlock x:Name="ReceivableText" FontSize="22" FontWeight="Bold"/></StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Padding="12" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="类型" VerticalAlignment="Center" Margin="4,0,6,0"/>
                <ComboBox x:Name="TypeBox" Width="125" Margin="0,0,12,0">
                    <ComboBoxItem Content="支出" Tag="Expense"/>
                    <ComboBoxItem Content="收入" Tag="Income"/>
                    <ComboBoxItem Content="我欠的 / 应付款" Tag="Payable"/>
                    <ComboBoxItem Content="别人欠我 / 待收款" Tag="Receivable"/>
                </ComboBox>
                <TextBlock Text="金额" VerticalAlignment="Center" Margin="4,0,6,0"/>
                <TextBox x:Name="AmountBox" Width="120" Margin="0,0,12,0"/>
                <TextBlock Text="账户" VerticalAlignment="Center" Margin="4,0,6,0"/>
                <ComboBox x:Name="AccountBox" Width="130" Margin="0,0,12,0"/>
                <TextBlock Text="分类" VerticalAlignment="Center" Margin="4,0,6,0"/>
                <TextBox x:Name="CategoryBox" Width="120" Margin="0,0,12,0"/>
                <TextBlock Text="日期" VerticalAlignment="Center" Margin="4,0,6,0"/>
                <DatePicker x:Name="DateBox" Width="130" Margin="0,0,12,0"/>
                <TextBlock Text="备注" VerticalAlignment="Center" Margin="4,0,6,0"/>
                <TextBox x:Name="NoteBox" Width="180" Margin="0,0,12,0"/>
                <Button Content="保存记录" Padding="18,7" Click="Save_Click"/>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,8">
                <TextBox x:Name="SearchBox" Width="250" DockPanel.Dock="Right"
                         ToolTip="搜索分类、备注或类型" TextChanged="Search_TextChanged"/>
                <TextBlock Text="收支记录" FontSize="20" FontWeight="SemiBold"/>
            </DockPanel>
            <DataGrid x:Name="RecordsGrid" Grid.Row="1" AutoGenerateColumns="False"
                      IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="日期" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="105"/>
                    <DataGridTextColumn Header="类型" Binding="{Binding TypeName}" Width="145"/>
                    <DataGridTextColumn Header="金额" Binding="{Binding Amount, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="账户" Binding="{Binding AccountName}" Width="120"/>
                    <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="130"/>
                    <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="*"/>
                    <DataGridTemplateColumn Header="操作" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="删除" Click="Delete_Click" Padding="8,3"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
