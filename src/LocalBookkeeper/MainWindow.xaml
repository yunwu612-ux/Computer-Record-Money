<Window x:Class="LocalBookkeeper.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="我的账本 V1.1" Width="1100" Height="720" MinWidth="900" MinHeight="620" WindowStartupLocation="CenterScreen" Background="#F5F7FA">
<Window.Resources><Style TargetType="Button"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="12,7"/><Setter Property="FontSize" Value="14"/></Style><Style TargetType="TextBox"><Setter Property="Padding" Value="8,6"/><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="4"/></Style><Style TargetType="ComboBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="6"/><Setter Property="FontSize" Value="14"/></Style></Window.Resources>
<Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel Grid.Row="0" Margin="0,0,0,12"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="账户管理" Click="Accounts_Click"/><Button Content="备份" Click="Backup_Click"/><Button Content="恢复" Click="Restore_Click"/></StackPanel><StackPanel><TextBlock Text="我的账本" FontSize="28" FontWeight="Bold"/><TextBlock Text="V1.1 · 本地保存" Foreground="#68707D"/></StackPanel></DockPanel>
<Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="White" CornerRadius="10" Padding="15" Margin="4"><StackPanel><TextBlock Text="当前资产" Foreground="#68707D"/><TextBlock x:Name="TotalBalanceText" Text="¥ 0.00" FontSize="23" FontWeight="Bold"/></StackPanel></Border>
<Border Grid.Column="1" Background="White" CornerRadius="10" Padding="15" Margin="4"><StackPanel><TextBlock Text="本月收入" Foreground="#68707D"/><TextBlock x:Name="IncomeText" Text="¥ 0.00" FontSize="23" FontWeight="Bold"/></StackPanel></Border>
<Border Grid.Column="2" Background="White" CornerRadius="10" Padding="15" Margin="4"><StackPanel><TextBlock Text="本月支出" Foreground="#68707D"/><TextBlock x:Name="ExpenseText" Text="¥ 0.00" FontSize="23" FontWeight="Bold"/></StackPanel></Border>
<Border Grid.Column="3" Background="White" CornerRadius="10" Padding="15" Margin="4"><StackPanel><TextBlock Text="我应付款" Foreground="#68707D"/><TextBlock x:Name="PayableText" Text="¥ 0.00" FontSize="23" FontWeight="Bold"/></StackPanel></Border>
<Border Grid.Column="4" Background="White" CornerRadius="10" Padding="15" Margin="4"><StackPanel><TextBlock Text="待收款" Foreground="#68707D"/><TextBlock x:Name="ReceivableText" Text="¥ 0.00" FontSize="23" FontWeight="Bold"/></StackPanel></Border></Grid>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="White" CornerRadius="12" Padding="14" Margin="4"><ScrollViewer><StackPanel>
<TextBlock Text="记一笔" FontSize="20" FontWeight="Bold" Margin="4,4,4,10"/>
<TextBlock Text="类型" Margin="4,8,4,0"/><ComboBox x:Name="TypeBox" SelectionChanged="TypeBox_SelectionChanged"><ComboBoxItem Tag="Expense" Content="支出"/><ComboBoxItem Tag="Income" Content="收入"/><ComboBoxItem Tag="Payable" Content="我欠的 / 应付款"/><ComboBoxItem Tag="Receivable" Content="别人欠我 / 待收款"/></ComboBox>
<TextBlock Text="金额" Margin="4,8,4,0"/><TextBox x:Name="AmountBox" ToolTip="请输入数字，例如 25.50"/>
<TextBlock Text="账户" Margin="4,8,4,0"/><ComboBox x:Name="AccountBox"/>
<TextBlock Text="分类" Margin="4,8,4,0"/><ComboBox x:Name="CategoryBox"><ComboBoxItem Content="餐饮"/><ComboBoxItem Content="购物"/><ComboBoxItem Content="交通"/><ComboBoxItem Content="住房"/><ComboBoxItem Content="娱乐"/><ComboBoxItem Content="工资"/><ComboBoxItem Content="其他"/></ComboBox>
<TextBlock Text="日期" Margin="4,8,4,0"/><DatePicker x:Name="DateBox" Margin="4"/>
<TextBlock Text="备注" Margin="4,8,4,0"/><TextBox x:Name="NoteBox" Height="70" AcceptsReturn="True" TextWrapping="Wrap"/>
<Button Content="保存这笔记录" Click="SaveTransaction_Click" FontWeight="Bold" Height="42" Margin="4,14,4,4"/><Button Content="清空输入" Click="ClearForm_Click"/>
<TextBlock x:Name="FormHint" Text="金额请输入正数，保存后会立即显示在右侧。" Foreground="#68707D" TextWrapping="Wrap" Margin="8"/>
</StackPanel></ScrollViewer></Border>
<Border Grid.Column="1" Background="White" CornerRadius="12" Padding="14" Margin="4"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<DockPanel Grid.Row="0" Margin="4,4,4,10"><TextBox x:Name="SearchBox" Width="230" DockPanel.Dock="Right" TextChanged="SearchBox_TextChanged"/><TextBlock Text="最近记录" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel>
<DataGrid x:Name="TransactionsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="日期" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="105"/><DataGridTextColumn Header="类型" Binding="{Binding TypeName}" Width="140"/><DataGridTextColumn Header="金额" Binding="{Binding Amount, StringFormat=¥ {0:N2}}" Width="110"/><DataGridTextColumn Header="账户" Binding="{Binding AccountName}" Width="110"/><DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="90"/><DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="*"/><DataGridCheckBoxColumn Header="已结清" Binding="{Binding IsSettled}" Width="70"/></DataGrid.Columns></DataGrid>
</Grid></Border></Grid>
<DockPanel Grid.Row="3" Margin="4,8,4,0"><TextBlock x:Name="StatusText" Text="数据保存在本机 AppData，不随程序安装目录变化。" Foreground="#68707D"/><Button Content="删除选中记录" DockPanel.Dock="Right" Click="DeleteTransaction_Click"/></DockPanel>
</Grid></Window>
