<Window x:Class="LocalBookkeeper.AccountWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="账户管理" Width="650" Height="480"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="账户管理" FontSize="24" FontWeight="Bold" Margin="0,0,0,12"/>
        <DataGrid x:Name="Grid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="账户" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="余额" Binding="{Binding Balance, StringFormat=N2}" Width="160"/>
                <DataGridTemplateColumn Header="操作" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="删除" Click="Delete_Click" Padding="8,3"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <WrapPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBox x:Name="NameBox" Width="180" Margin="0,0,8,0" ToolTip="账户名称"/>
            <TextBox x:Name="BalanceBox" Width="120" Margin="0,0,8,0" ToolTip="初始余额"/>
            <Button Content="添加账户" Padding="14,6" Click="Add_Click"/>
        </WrapPanel>
    </Grid>
</Window>
