<Window x:Class="LocalBookkeeper.AccountWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="账户管理" Width="620" Height="500" WindowStartupLocation="CenterOwner" Background="#F5F7FA">
<Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Grid.Row="0"><TextBlock Text="账户管理" FontSize="24" FontWeight="Bold"/><TextBlock Text="设置你目前实际拥有的钱，例如现金、银行卡余额。" Foreground="#68707D" Margin="0,4,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="NameBox" Grid.Column="0" ToolTip="账户名称"/><TextBox x:Name="BalanceBox" Grid.Column="1" ToolTip="现有余额"/><Button Grid.Column="2" Content="添加账户" Click="Add_Click"/></Grid></StackPanel>
<DataGrid x:Name="AccountsGrid" Grid.Row="1" Margin="4,14,4,10" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="账户" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="余额" Binding="{Binding Balance, StringFormat=¥ {0:N2}}" Width="160"/></DataGrid.Columns></DataGrid>
<DockPanel Grid.Row="2"><TextBlock x:Name="TotalText" VerticalAlignment="Center" Foreground="#68707D"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="删除选中" Click="Delete_Click"/><Button Content="完成" Click="Done_Click" FontWeight="Bold"/></StackPanel></DockPanel></Grid></Window>
